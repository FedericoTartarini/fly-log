{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "coderabbit *": "allow",
      "coderabbit --prompt-only --type uncommitted": "allow",
      "coderabbit --prompt-only --base *": "allow",
      "git branch --show-current": "allow",
      "git commit": "ask",
      "git commit *": "ask",
      "git push": "deny",
      "git push *": "deny",
      "git diff *": "allow",
      "npm test *": "allow",
      "pytest *": "allow",
      "npm test": "allow",
      "npm install": "allow",
      "npm run vitest": "allow",
      "npm run vitest:watch": "allow",
      "npm run lint -- --fix": "allow",
      "npm install *": "ask",
      "rm *": "deny",
      "rm -rf coverage": "allow",
      "rm *.log": "allow",
      "rm -rf *": "deny",
      "npm run lint": "allow",
      "grep *": "allow"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
