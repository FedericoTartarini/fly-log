{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "coderabbit *": "allow",
      "git commit *": "ask",
      "git push *": "deny",
      "git diff *": "allow",
      "npm test *": "allow",
      "pytest *": "allow",
      "npm *": "ask",
      "rm *": "deny",
      "grep *": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
