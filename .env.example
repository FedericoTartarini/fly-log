CY_WRONG_EMAIL="xxx@gmail.com"
CY_WRONG_PASSWORD="wrong_password"
CY_TEST_EMAIL="email@test_cypress.com"
CY_TEST_PASSWORD="password_test_cypress"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# PROJECT_ID and MESSAGING_SENDER_ID (the project number) are also read
# server-side by netlify/functions/flight-status/appCheck.js to pin the App
# Check token's issuer and audience. In Netlify they must be visible to
# functions, not scoped to builds only, or every status check returns 500.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# reCAPTCHA Enterprise (score-based, web) site key for App Check.
# Create with: gcloud recaptcha keys create --project=<project-id> --display-name=<name> \
#   --web --domains=<your-domain>,localhost --integration-type=SCORE
VITE_RECAPTCHA_SITE_KEY=
# CARTO basemap tiles (WorldMap.jsx). Free, no account: https://carto.com/basemaps/apikey/
VITE_CARTO_API_KEY=
# AeroDataBox (RapidAPI) flight status - server-side only, read by
# netlify/functions/flight-status/flight-status.js. Never prefix with VITE_.
RAPIDAPI_AERODATABOX_KEY=